# ---------------------------------------------------------------------------
# EOS — catalog source
# ---------------------------------------------------------------------------
# Copy to .env.local to change where product data comes from.
# With nothing set, the site runs on src/lib/shopify/placeholder-data.ts
# exactly as it does today. Nothing here activates checkout.

# "placeholder" (default) | "shopify"
# EOS_CATALOG_SOURCE=shopify

# Defaults to Shopify's credential-free mock storefront, which speaks the real
# Storefront API shape and is what the Shopify path was developed against.
# For a real store: https://<shop>.myshopify.com/api/2025-07/graphql.json
# SHOPIFY_STOREFRONT_ENDPOINT=https://mock.shop/api

# Public Storefront access token. Omitted for mock.shop, required for a real
# store. The app needs `unauthenticated_read_product_inventory` or every
# quantity comes back null and the site shows "Available" instead of a count.
# SHOPIFY_STOREFRONT_TOKEN=

# The product the homepage opens on. Falls back to the first open lot.
# EOS_HERO_HANDLE=heavyweight-hoodie

# ---------------------------------------------------------------------------
# EOS-owned metafields
# ---------------------------------------------------------------------------
# Namespace holding lot_code, specs and garment_asset. Whoever configures the
# store decides this; it is the single most likely value to differ.
# EOS_METAFIELD_NAMESPACE=eos

# ---------------------------------------------------------------------------
# Freshness
# ---------------------------------------------------------------------------
# Shared secret for POST /api/revalidate. Without it the route returns 503
# rather than accepting unsigned requests. Set it to the webhook's signing
# secret from the Shopify admin.
# SHOPIFY_REVALIDATE_SECRET=

# Fallback refresh floor in seconds, for when the webhook is not configured.
# EOS_CATALOG_REVALIDATE=60
