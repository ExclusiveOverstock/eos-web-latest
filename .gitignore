# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build output
/.next/
/out/
/build
next-env.d.ts

# Production
/dist

# Secrets.
#
# .env.local holds the live Shopify Storefront token. It must never be
# committed — not because the token is private (a Storefront token is a public
# one, meant to be visible to browsers) but because a committed credential
# outlives the repo: it survives in history after deletion, gets scraped, and
# has to be rotated rather than removed. .env.example is committed instead and
# lists the variable names with no values.
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# Testing
/coverage

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# TypeScript incremental build cache
*.tsbuildinfo

# Vercel
.vercel

# Editor / OS noise
.DS_Store
*.pem
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
